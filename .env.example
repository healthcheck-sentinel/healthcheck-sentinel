# ─────────────────────────────────────────────
# healthcheck-sentinel – Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── General ──────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=your_credential_here

# ── FastAPI Services ──────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=true                  # set false in production

# ── Database (shared sentinel DB) ────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sentinel_db

# ── Redis (shared / task queue) ───────────────
REDIS_URL=redis://localhost:6379/0

# ── payment-service connections ───────────────
# postgresql://[user]:[password]@[host]:[port]/[dbname]
PAYMENT_DB_URL=postgresql://postgres:changeme@localhost:5432/payments_db
PAYMENT_REDIS_URL=redis://localhost:6379/0
PAYMENT_DB_CONNECT_TIMEOUT=3.0
PAYMENT_REDIS_CONNECT_TIMEOUT=3.0
PAYMENT_LOG_LEVEL=INFO

# ── order-service connections ─────────────────
ORDER_DB_URL=postgresql://postgres:changeme@localhost:5432/orders_db
ORDER_REDIS_URL=redis://localhost:6379/1
ORDER_DB_CONNECT_TIMEOUT=3.0
ORDER_REDIS_CONNECT_TIMEOUT=3.0
ORDER_LOG_LEVEL=INFO

# ── Prometheus ───────────────────────────────
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
METRICS_PORT=9090

# ── AI Agent ─────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
AGENT_MODEL=gemini-2.5-pro
AGENT_TEMPERATURE=0.2

# ── ChatOps – Slack ───────────────────────────
SLACK_BOT_TOKEN=your_credential_here
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_ALERT_CHANNEL=#alerts

# ── ChatOps – PagerDuty ───────────────────────
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# ── Kubernetes ───────────────────────────────
KUBECONFIG=/path/to/.kube/config
K8S_NAMESPACE=healthcheck-sentinel
