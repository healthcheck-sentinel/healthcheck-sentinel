# ---------------------------------------------------------
# healthcheck-sentinel - Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ---------------------------------------------------------

# -- General -----------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=

# -- FastAPI Services --------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=true                  # set false in production

# -- PostgreSQL Configuration ------------------------------
POSTGRES_DB=healthcheck
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/healthcheck

# -- Redis Configuration -----------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# -- payment-service connections ---------------------------
PAYMENT_DB_URL=postgresql://postgres:postgres@postgres:5432/healthcheck
PAYMENT_REDIS_URL=redis://redis:6379/0
PAYMENT_DB_CONNECT_TIMEOUT=3.0
PAYMENT_REDIS_CONNECT_TIMEOUT=3.0
PAYMENT_LOG_LEVEL=INFO

# -- order-service connections -----------------------------
ORDER_DB_URL=postgresql://postgres:postgres@postgres:5432/healthcheck
ORDER_REDIS_URL=redis://redis:6379/1
ORDER_DB_CONNECT_TIMEOUT=3.0
ORDER_REDIS_CONNECT_TIMEOUT=3.0
ORDER_LOG_LEVEL=INFO

# -- Prometheus --------------------------------------------
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
METRICS_PORT=9090

# -- Monitoring Agent --------------------------------------
# The agent is deterministic - no AI API keys required.
# Poll interval in seconds between health checks.
AGENT_POLL_INTERVAL_SECONDS=4
# Per-request HTTP timeout for each health/readiness probe.
AGENT_TIMEOUT_SECONDS=3
# Delay between validation probes after a failure or during recovery.
AGENT_RETRY_DELAY_SECONDS=1
# Consecutive failures before an alert is fired.
AGENT_FAILURE_THRESHOLD=3
# Consecutive successes required to mark a service recovered.
AGENT_RECOVERY_THRESHOLD=2
# Optional JSON array overriding the defaults. Each entry has name, base_url,
# and critical_dependencies; healthz_path and readyz_path default to /healthz and /readyz.
# SERVICE_REGISTRY_JSON=[{"name":"payment-service","base_url":"http://localhost:8001","critical_dependencies":["postgres","redis"]}]
AGENT_LOG_LEVEL=INFO

# -- ChatOps - Slack ---------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALERT_CHANNEL=#alerts

# -- ChatOps - PagerDuty -----------------------------------
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# -- Kubernetes --------------------------------------------
KUBECONFIG=/path/to/.kube/config
K8S_NAMESPACE=healthcheck-sentinel
STATUS_PORT=9101

# Optional interactive Slack actions (host operator server; defaults disabled).
SLACK_ACTIONS_ENABLED=false
SLACK_ALLOWED_TEAM=
SLACK_ALLOWED_USERS=
SLACK_ALLOWED_CHANNELS=
# Set the existing SLACK_SIGNING_SECRET privately in .env, never in this example.
